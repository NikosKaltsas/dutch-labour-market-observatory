# Keep the finished PBIX; exclude local recovery/cache artifacts
*.pbix.tmp
*.pbit.tmp
**/.pbi/
**/localSettings.json
**/cache.abf
~$*
tmp/
temp/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Python and local tools
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
dist/
build/
*.egg-info/

# dbt outputs and local user identity
target/
dbt_packages/
logs/
.user.yml

# Local configuration and credentials
.env
.env.*
!.env.example
*.pem
*.key
.vscode/
.idea/

# Rebuildable data (retain directory placeholders)
data/raw/**
data/processed/**
data/warehouse/**
data/dashboard/**
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/warehouse/.gitkeep
!data/dashboard/.gitkeep
*.duckdb
